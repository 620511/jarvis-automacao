# Copie este arquivo para ".env" e preencha. NUNCA suba o .env para o GitHub.
# Todos os campos são opcionais: o que estiver vazio é simplesmente pulado.

# GitHub (token somente leitura)
GITHUB_TOKEN=

# Vercel
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# Render
RENDER_API_KEY=

# IA que explica a causa dos problemas
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Avisos no notebook
VOICE=true
OPEN_PANEL_ON_ALERT=true

# true = Jarvis refaz o deploy sozinho no Render quando a API cai (máx. 1x a cada 30 min)
AUTO_HEAL=false

# De quantos em quantos minutos verificar
INTERVAL_MIN=5
